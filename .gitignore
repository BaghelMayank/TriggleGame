# ---------------------------------------------------------------- Unity
# Regenerated by the editor from Assets/ + ProjectSettings/ + Packages/.
# Committing them causes constant spurious conflicts and bloats the repo.
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store downloads: re-importable, and often large.
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/Plugins/Editor/JetBrains*

# ---------------------------------------------------------------- IDE
# Solution and project files are generated from the packages + scripts.
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

.vs/
.idea/
.vscode/
.gradle/
.consulo/

# ---------------------------------------------------------------- Builds
*.apk
*.aab
*.unitypackage
*.app
ExportedObj/
crashlytics-build.properties

# ---------------------------------------------------------------- OS
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- Local
# Anything under here is scratch for tooling, never part of the game.
/.claude/
